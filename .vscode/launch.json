{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Go Backend (Debug)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/backend/main.go",
            "cwd": "${workspaceFolder}/backend",
            "env": {
            },
            "args": []
        },
        {
            "name": "Attach to Go Backend",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "remotePath": "${workspaceFolder}/backend",
            "port": 2345,
            "host": "127.0.0.1",
            "showLog": true,
            "apiVersion": 2,
            "trace": "verbose"
        }
    ]
} 